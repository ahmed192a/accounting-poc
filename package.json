{
  "name": "accounting-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof of concept: append-only ledger, granular roles with role-specific home views, offline e-receipt queue with a mock ETA adapter",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "test": "node --no-warnings --test \"test/**/*.test.js\"",
    "coverage": "node scripts/coverage-check.js",
    "check": "node --no-warnings scripts/check-repo.js",
    "openapi": "node --no-warnings scripts/openapi.js",
    "smoke": "node scripts/smoke-server.js"
  },
  "engines": { "node": ">=22.13" }
}
